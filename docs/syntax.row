require "core.utils" # import everything from utils into current scope
require "core.io" as io # import everything from io into the io namespace

require "custom_package" from "path to the package"

require "core.math.sqrt()" # import only one function into current scope
require "core.math.Vector2" # same but with struct

from "core.math" require "sqrt(),Vector2" # import multiple things into current scope
from "core.file" require "read_file(),Reader" as fs # also work with custom namespace

# folders are like namespaces and files are a collections of function, struct, etc.
# Ex. core is a folder with files like math.rose, file.rose, etc. Those files contains
# functions, struct, etc. like sqrt() or Vector2

# the default mathematicals operator are
- 1 # negative
1 + 1 # adition
1 - 1 # substration
1 * 1 # multiplication
1 / 1 # division
1 // 1 # euclidian division
1 % 1 # reminder
1 ^ 5 # power
|1.34| # absolute value

# the default logical operators and binari operators are
true && true
true || false
true and true
true or false

! true
not true

true == false
true != false
1 == 1
1 != 5

1 > 1
1 >= 1
1 < 1
1 <= 1

1 << 4
1 >> 4
1 | 4
1 & 4
~ 1

# the default types are
u8   i8
u16  i16
u32  i32
u64  i64
u128 i128
f16
f32
f64
f128
bool
void
binari
hexadecimal
octal

string
array
vector
hashmap
stack
queue

pointer
usize isize
c_char
c_short
c_ushort
c_int
