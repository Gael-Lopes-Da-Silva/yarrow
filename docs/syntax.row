c_long
c_ulong
c_longlong
c_ulonglong
c_double
c_longdouble

# structs are declared like this
struct MyStruct
    i32 myVal
    i32 myOtherVal = 43 # we have defaults
end

# by default everything is private, if we want to export a sctruct or other thing
public MyOtherStruct
    public i8 publicVal
    f64 privateVal
end

# there can be inheritance
struct MyInheritedStruct from MyStruct
    # already has myVal and myOtherVal
end

# enums are declared like this
enum myEnum
    FIRST
    SECOND
    LAST
end

# enums use u32 by default but we can change this
enum mySecondEnum use f32
    FIRST # 0.0
    SECOND # 1.0
    LAST # 2.0
end

# by default enums use a step of 1, but we can change it
enum myThirdEnum use f32 by 0.1
    FIRST # 0.0
    SECOND # 0.1
    LAST # 0.2
end

# enums inheritance is done like that
enum inheritedEnum from myEnum
    # already has FIRST, SECOND and LAST
    THIRD
    FOURTH
end

# unions are declared like this
union MyUnion # MyUnion will be one of those three
    i32
    bool
    f64
end

# by default variable are like runtime constant and cannot be changed after initialization
i32 myVariable = 32 # we need to give a value

# you can declare mutable variable like this
mutable i32 myMutableVariable = 45
myMutableVariable = 23

# you can define compile time constant like this
constant i32 myConstant = 32 # need to be a value known at compile time

# function are declared like that
function my_function() do
    # do things
end with void # define return value

# functions can take parameters
function my_params(i32 first, string second) do
    # do things with parameters
end with void

# entry point of a program is main
function main() do
    # do things
end with void

# we can return a code when program terminat
function main() do
    # do things
    return 0
end with i32

# by default functions use garbage collector, but it can be changed
function my_lifetime_function() use lifetime do # lifetime functions work with a borrow checker
    # we can define a block (new scope) like this
    block
        mutable i32 outOfScope = 32
    end

    outOfScope = 42 # don't work because unreferenced (out of scope)

    mutable i32 borrowMe = 32
    mubable i32 borrower = borrow borrowMe # we can borrow ownership like this
    mutable i32 copyCat = copy borrower # create a new value from borrowMe
end with void

# we can also chose manual memory management
function my_unsafe_function() use unsafe do
    mutable i32 pointedValue = 376
    mutable pointer myPointer = pointedValue as ref
    defer free myPointer

    (myPointer as val) = 534 # change the value of the pointed mutable variable

    # we can create a new struct like this
    mutable MyStruct myStruct = {
        myVal = 4
        # no need to initialize myOtherVal because it has a default value
    }
    mutable pointer myPointerToStruct = myStruct as ref
    defer free myPointerToStruct

    myPointerToStruct.myVal = 5 # auto dereferencing
end with void

# to change the default memory management methode globaly use
global garbage_collector # all function will use by default this one
global lifetime # all functions will use lifetime by default if used
global unsafe # same applys here

# conditions are made like this
if true do
    # do something
else if false do
    # do something
else do
    # do something
end

match myMutableVariable
    case 43
        # do something
    end

    case default
        # else default
    end
end

# loops are made like this
while true do
    # do something
end

do
    # do something
while true end

for i in i32.range(0, 10) do
    # do something 10 times with i as i32
end

# we can declare aliases like this
alias MY_ALIAS as 3
MY_ALIAS # will be replaced by 3

alias finish <T> as end with <T>

function aliased_end() do
finish void # all finish will be replaced by end with <a type>

# alias can also replace expresions like functions, conditions, etc.
alias add <T> <U> as function () do
    return <T> + <U> # must be two compatible types
end with i32

i32 addition = add 2 4

# error handling is done on a function if anything in it's scope return an error union
require "core.file" as file
function error_handling() do
    discard try file.read_file("r", "file-name.txt") # use discard to discard returned value if any
    # read_file return File struct or FileErrors enum whitch contains all file related errors like ReadError
end with void else ReadError

# hello world
function main() do
    try io.print_line("Hello, world!") # don't forget to require core.io (optionally as io)
    try io.print_format("{}", "Hello, space!")
end with void else AnyError # AnyError is the default error

# we can add methodes to struct like that
implement for MyStruct
    # here are declared methodes
    function myMethode() do
        self.myVal = 43 # if myMethode is used, the variable that host the struct need to be mutable
    end with void

    # constructor
    function new(i32 myVal, i32 otherValue) do
        return {
            myVal # we can omit initialization if same name
            myOtherVal = otherValue
        }
    end with self
end

# structure of a project
src/
  main.row
build/
  debug/
  release/
yarrow.toml

# the toml file work like this
[package]
name = myName
version = 0.0.1
optimization = 1 # form 0 to 3
yarrow = 0.0.1 # yarrow version

[deps]
myDep = "link to the git repos" # require "myDeps" as myDeps to use

[deps.dev]
myDevDep = "link to the git repos"

# the cli should be used like this
yarrow run # interpret current working directory file with main entry point

yarrow build # compile current working directory file with main entry point
yarrow build debug # default build methode
yarrow build release
yarrow build run # compile and run executable

yarrow alias replace # replace all alias with thier value

yarrow add name "link the a git repos"
yarrow update name # pull from repos
yarrow update * # update all
yarrow remove name

yarrow add name "link the a git repos" --dev # add dev dependencies
yarrow remove name --dev

yarrow lsp # default lsp provider
yarrow fmt # default formateryarrow
